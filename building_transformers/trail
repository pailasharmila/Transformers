# building neural nets modules

class NeuralNetwork(nn.Module):
    def __init__(self):
        # this runs when ever a NeuralNetwork model is created
        super().__init__()  # initializes pytorch internals, that means setting up every tihng for a neural nets from nn.Module Parent class using super() keyword
        self.linear=nn.Linear(10,5)  # neural network with 10 inputs and 5 outputs
        
    def forward(self,x):
        # this method defines what happens when data flows through the model
        if ((x.shape)[-1])!=10:
            return -1
        return self.linear(x)  # here x is the input that we are sending inside the neural network


obj1=NeuralNetwork()
x=torch.randn(2,10)
output = obj1.forward(x)
print("output of the created neural network is", output)

# 1. Instantiate the layer (Vocabulary of 5 tokens, each embedding is 3 dimensions)
embed = nn.Embedding(num_embeddings=5, embedding_dim=3)

# 2. Define an input tensor of integer tokens (Shape: Batch Size = 2, Sequence Length = 4)
# Note: Input must contain values within the range [0, num_embeddings - 1]
input_indices = torch.tensor([[1, 2, 4, 0], 
                             [4, 3, 2, 1]], dtype=torch.long)

# 3. Perform the forward lookup pass
output_vectors = embed(input_indices)

print("Input Shape: ", input_indices.shape)   # Output: torch.Size([2, 4])
print("Output Shape:", output_vectors.shape)  # Output: torch.Size([2, 4, 3])
print("\nGenerated Dense Vectors:\n", output_vectors)


## AUTOGRAD- This makes neural network learn
## Pytorch has an advantage of this Dynamic computation Graph compared to the static frame work from TensorFlow(prior 2.O)
# https://medium.com/@serverwalainfra/understanding-pytorchs-dynamic-computational-graphs-bf77ee51e5c8

# if the "requires_grad=True" , then the graph records all operations that involved with that paricular tensor 

x=torch.tensor(2.0, requires_grad=True)  # only leaf node store the gradients
y=torch.tensor(3.0,requires_grad=True)

z=x*y+y**2
# Back Propagate
z.backward()
#Gradients

def display_gradients():
    print(f'dz/dx:{x.grad}')
    print(f'dz/dy:{y.grad}')
    print(z.grad_fn) # This references a hidden backward function object (e.g., <MulBackward0>, <AddBackward0>)
    print(x.grad_dtype)

display_gradients()